      "Defined_wayfinder.md",
      "LICENSE",
      "README.md",
      "Workflow.md",
      "library/__init__.py",
      "library/MODULE_CATALOG.md"
    ],
    "excludedSegments": ["__pycache__", ".git"],
    "excludedSuffixes": [".pyc", ".pyo"]
  }
}
